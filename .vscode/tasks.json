{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar Todo",
      "dependsOn": [
        "1. GraphHopper",
        "2. Backend",
        "3. Frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "1. GraphHopper",
      "type": "shell",
      "command": "java -jar graphhopper-web-8.0.jar server config.yml",
      "options": {
        "cwd": "${workspaceFolder}/services/graphhopper"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "2. Backend",
      "type": "shell",
      "command": ".\\mvnw.cmd spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/apps/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "3. Frontend",
      "type": "shell",
      "command": "pnpm dev:web",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}